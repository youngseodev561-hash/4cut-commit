# ── 로컬(전시장 노트북)에서 돌릴 때 ──
# 휴대폰이 QR로 접속할 주소 (노트북의 같은 와이파이 IP). 배포 환경에선 비워두면 자동.
PUBLIC_URL=
NEXT_PUBLIC_PUBLIC_URL=
DATA_DIR=./data
RETENTION_DAYS=7

# ── Vercel 배포 시 (대시보드 Storage에서 연결하면 자동으로 들어감) ──
# Vercel Blob → 사진 저장
BLOB_READ_WRITE_TOKEN=
# Upstash Redis → 사진 정보 · 방명록
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 방명록 관리자 페이지(/admin) 비밀번호 — 배포 시 꼭 설정
ADMIN_KEY=
